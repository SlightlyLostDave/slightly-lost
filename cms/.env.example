# Server
HOST=0.0.0.0
PORT=1337

# Secrets, generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_KEYS takes a comma-separated list, run the command above four times
# and join the values with commas.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database
# Local dev default is sqlite, which only needs DATABASE_CLIENT and
# DATABASE_FILENAME. Point production at Postgres 17 (14 is the floor) by
# setting DATABASE_CLIENT=postgres and filling in the rest below, no config
# file edits required.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
