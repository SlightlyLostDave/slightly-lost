{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/assert-no-draft-leak.mjs && node scripts/assert-atlas-policy.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "lint": "eslint .",
    "cms:dev": "npm run develop --prefix cms",
    "cms:build": "npm run build --prefix cms",
    "cms:seed": "npm run seed --prefix cms",
    "cms:token": "npm run token --prefix cms",
    "test": "node --test \"src/**/*.test.ts\"",
    "pretest:e2e": "npm run build && (astro preview stop || true) && npm run preview -- --port 4400",
    "test:e2e": "playwright test",
    "posttest:e2e": "astro preview stop",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:budget": "playwright test --project=chromium --grep budget",
    "lhci": "lhci autorun --config=./lighthouserc.cjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "gsap": "^3.15.0",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0",
    "qs": "^6.15.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/qs": "^6.15.1",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.151.0"
  }
}
