---
import { getCollection } from 'astro:content'
import Base from '@/layouts/Base.astro'
import Label from '@/components/primitives/Label.astro'
import Hairline from '@/components/primitives/Hairline.astro'
import SeriesGrid from '@/components/series/SeriesGrid.astro'
import { getSeriesSlots } from '@/lib/series'

const allSeries = await getCollection('series')
const posts = await getCollection('posts')

const rows = allSeries
  .map((series) => ({
    series,
    episodeCount: getSeriesSlots(series, posts).slots.filter((slot) => slot.kind === 'published').length,
  }))
  .filter((row) => row.episodeCount > 0)
---

<Base type="website" title="Series" description="Ordered reading sequences across the field notes." surface="ink" headerState="solid">
  <div class="max-w-content mx-auto flex flex-col gap-16 px-6 py-16 md:py-(--spacing-section)">
    <div class="flex flex-col gap-6">
      <Label accentRule>Series</Label>
      <h1 class="font-display text-display-l text-text-strong">Series</h1>
      <Hairline class="mt-2" />
    </div>

    <SeriesGrid rows={rows} />
  </div>
</Base>
