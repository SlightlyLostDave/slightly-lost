---
import type { GetStaticPathsOptions } from 'astro'
import Listing from '@/layouts/Listing.astro'
import { fieldNotes, pillars } from '@/config'
import { getPublishedPosts } from '@/lib/posts'

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedPosts()
  const sorted = [...posts].sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  )
  return paginate(sorted, { pageSize: 12 })
}

const { page } = Astro.props
---

<Listing
  title={fieldNotes.title}
  description={fieldNotes.intro}
  label={fieldNotes.label}
  entries={page.data}
  page={page}
  basePath="/field-notes"
>
  <Fragment slot="intro">{fieldNotes.intro}</Fragment>

  <nav aria-label="Filter by pillar" class="flex flex-wrap gap-2">
    <a
      href="/field-notes"
      aria-current="page"
      class="border-sage bg-sage/20 text-label text-sage inline-flex items-center rounded-full border px-3 py-1.5 font-mono uppercase"
    >
      All
    </a>
    {
      pillars.map((pillar) => (
        <a
          href={`/field-notes/${pillar.slug}`}
          class="border-hairline text-label text-text-muted hover:border-sage hover:text-sage focus-visible:outline-accent inline-flex items-center rounded-full border px-3 py-1.5 font-mono uppercase focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:transition-colors"
        >
          {pillar.name}
        </a>
      ))
    }
  </nav>
</Listing>
