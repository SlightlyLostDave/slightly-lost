---
import { getCollection, type CollectionEntry } from 'astro:content'
import Article from '@/layouts/Article.astro'
import FullBleed from '@/components/media/FullBleed.astro'
import FieldDataStrip from '@/components/sections/FieldDataStrip.astro'
import ArticleBody from '@/components/content/ArticleBody.astro'
import SourceList from '@/components/sections/SourceList.astro'
import SeriesStrip from '@/components/series/SeriesStrip.astro'
import TagList from '@/components/content/TagList.astro'
import { pillarBySlug } from '@/config/pillars'
import { getSeriesPosition, type SeriesPosition } from '@/lib/series'
import { getPublishedPosts } from '@/lib/posts'

export async function getStaticPaths() {
  // Unfiltered on purpose: a draft still needs a generated page at its own
  // URL. Only the sibling lookups below use the published-only set, so a
  // draft is never linked to from anywhere but its own page.
  const posts = await getCollection('posts')
  const publishedPosts = await getPublishedPosts()
  const allSeries = await getCollection('series')
  const allTags = await getCollection('tags')

  return posts.map((post) => {
    const pillar = pillarBySlug[post.data.pillar]
    if (!pillar) {
      throw new Error(`Post "${post.id}" has an unrecognized pillar slug "${post.data.pillar}"`)
    }

    const seriesPosition = getSeriesPosition(post, publishedPosts, allSeries)
    const postTags = post.data.tags
      .map((ref) => allTags.find((tag) => tag.id === ref.id))
      .filter((tag): tag is CollectionEntry<'tags'> => tag !== undefined)

    return {
      params: { pillar: pillar.slug, slug: post.id },
      props: { post, seriesPosition, postTags },
    }
  })
}

interface Props {
  post: CollectionEntry<'posts'>
  seriesPosition?: SeriesPosition
  postTags: CollectionEntry<'tags'>[]
}

const { post, seriesPosition, postTags } = Astro.props
const isDraft = post.data.status === 'draft'
---

<Article
  title={post.data.title}
  description={post.data.dek}
  publishedAt={post.data.publishedAt ?? post.data.updatedAt}
  authorName={post.data.authorName}
  pillar={post.data.pillar}
  region={post.data.region}
  readingTime={post.data.readingTime}
  photoCount={post.data.photoCount}
  noindex={isDraft || post.data.seo?.noindex}
  isDraft={isDraft}
>
  <Fragment slot="hero">
    <FullBleed
      src={post.data.hero.src}
      width={post.data.hero.width}
      height={post.data.hero.height}
      alt={post.data.hero.alt}
    />
  </Fragment>

  <Fragment slot="field-data">
    <FieldDataStrip items={post.data.fieldData} />
  </Fragment>

  <ArticleBody body={post.data.body} />

  {
    seriesPosition && (
      <Fragment slot="series-nav">
        <SeriesStrip position={seriesPosition} />
      </Fragment>
    )
  }

  {
    postTags.length > 0 && (
      <Fragment slot="tags">
        <TagList tags={postTags} />
      </Fragment>
    )
  }

  <Fragment slot="sources">
    <SourceList sources={post.data.sources} />
  </Fragment>
</Article>
