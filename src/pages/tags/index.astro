---
import { getCollection } from 'astro:content'
import Base from '@/layouts/Base.astro'
import Label from '@/components/primitives/Label.astro'
import Hairline from '@/components/primitives/Hairline.astro'
import { getPostsByTag } from '@/lib/tags'

const tags = await getCollection('tags')
const posts = await getCollection('posts')

const rows = tags
  .map((tag) => ({ tag, count: getPostsByTag(tag, posts).length }))
  .filter((row) => row.count > 0)
  .sort((a, b) => a.tag.data.name.localeCompare(b.tag.data.name))
---

<Base type="website" title="Tags" description="Every tag used across the field notes." surface="ink" headerState="solid">
  <div class="max-w-content mx-auto flex flex-col gap-16 px-6 py-16 md:py-(--spacing-section)">
    <div class="flex flex-col gap-6">
      <Label accentRule>Tags</Label>
      <h1 class="font-display text-display-l text-text-strong">Tags</h1>
      <Hairline class="mt-2" />
    </div>

    <ol class="flex flex-col">
      {
        rows.map(({ tag, count }) => (
          <li>
            <Hairline />
            <a
              href={`/tags/${tag.id}`}
              class="flex items-baseline justify-between gap-4 py-5 motion-safe:transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4"
            >
              <span class="font-display text-title text-text-strong">{tag.data.name}</span>
              <span class="font-mono text-data tabular-nums text-text-muted">{count}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>
