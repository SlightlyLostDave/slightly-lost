---
import Base from '@layouts/Base.astro'
import Hero from '@components/sections/Hero.astro'
import Interstitial from '@components/sections/Interstitial.astro'
import FeaturedDispatch from '@components/sections/FeaturedDispatch.astro'
import PillarGrid from '@components/sections/PillarGrid.astro'
import RecentNotes from '@components/sections/RecentNotes.astro'
import AtlasTeaser from '@components/sections/AtlasTeaser.astro'
import GuidesLogbooks from '@components/sections/GuidesLogbooks.astro'
import Newsletter from '@components/sections/Newsletter.astro'
import { site } from '@/config'
---

<Base
  type="website"
  title={site.name}
  description={site.description}
  surface="ink"
  headerState="transparent"
>
  <Hero />
  <Interstitial />
  <FeaturedDispatch />
  <PillarGrid />
  <RecentNotes />
  <AtlasTeaser />
  <GuidesLogbooks />
  <Newsletter />
</Base>
