---
// Scratch tool for Phase 1 typeface work. Verifies the full type scale, in
// both themes, at the correct weights and families. Delete before Phase 2.
import Layout from '../layouts/Layout.astro'

const pangram = 'The five boxing wizards jump quickly.'
const sampleData = '58.3019° N, 3.1508° W · -42m · 2026-08-25'

const newsreaderLevels = [
  { token: 'display-xl', label: 'Display XL' },
  { token: 'display-l', label: 'Display L' },
  { token: 'display-m', label: 'Display M' },
]

const interTightLevels = [
  { token: 'title', label: 'Title' },
  { token: 'body', label: 'Body' },
  { token: 'caption', label: 'Caption' },
]

const plexMonoLevels = [
  { token: 'label', label: 'Label' },
  { token: 'data', label: 'Data' },
]
---

<Layout title="Type scale">
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0;">
    <section data-theme="light" style="background-color: var(--color-surface); padding: 2rem; border-right: 1px solid var(--color-hairline);">
      <p style="font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label--letter-spacing); color: var(--color-accent); text-transform: uppercase;">
        Light theme
      </p>

      <h2 style="font-family: var(--font-ui); font-weight: 600; color: var(--color-text-strong);">Newsreader</h2>
      {
        newsreaderLevels.map((level) => (
          <div style={`border-top: 1px solid var(--color-hairline); padding: 1rem 0;`}>
            <p
              class="font-[var(--weight-display)]"
              style={`font-family: var(--font-display); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-strong);`}
            >
              Slightly Lost
            </p>
            <p style={`font-family: var(--font-display); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-body); font-weight: 400;`}>
              {pangram}
            </p>
          </div>
        ))
      }
      <div style="border-top: 1px solid var(--color-hairline); padding: 1rem 0;">
        <p style="font-family: var(--font-display); font-size: var(--text-body-l); line-height: var(--text-body-l--line-height); color: var(--color-text-strong); font-weight: 400;">
          Slightly Lost
        </p>
        <p style="font-family: var(--font-display); font-size: var(--text-body-l); line-height: var(--text-body-l--line-height); color: var(--color-text-body); font-weight: 400; font-style: italic;">
          {pangram}
        </p>
      </div>

      <h2 style="font-family: var(--font-ui); font-weight: 600; color: var(--color-text-strong); margin-top: 2rem;">Inter Tight</h2>
      {
        interTightLevels.map((level) => (
          <div style="border-top: 1px solid var(--color-hairline); padding: 1rem 0;">
            <p style={`font-family: var(--font-ui); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-strong);`}>
              Slightly Lost
            </p>
            <p style={`font-family: var(--font-ui); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-body);`}>
              {pangram}
            </p>
          </div>
        ))
      }

      <h2 style="font-family: var(--font-ui); font-weight: 600; color: var(--color-text-strong); margin-top: 2rem;">IBM Plex Mono</h2>
      {
        plexMonoLevels.map((level) => (
          <div style="border-top: 1px solid var(--color-hairline); padding: 1rem 0;">
            <p style={`font-family: var(--font-mono); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-strong);`}>
              Slightly Lost
            </p>
            <p style={`font-family: var(--font-mono); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-body); font-variant-numeric: tabular-nums;`}>
              {sampleData}
            </p>
          </div>
        ))
      }
    </section>

    <section data-theme="dark" style="background-color: var(--color-surface); padding: 2rem;">
      <p style="font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--text-label--letter-spacing); color: var(--color-accent); text-transform: uppercase;">
        Dark theme
      </p>

      <h2 style="font-family: var(--font-ui); font-weight: 600; color: var(--color-text-strong);">Newsreader</h2>
      {
        newsreaderLevels.map((level) => (
          <div style="border-top: 1px solid var(--color-hairline); padding: 1rem 0;">
            <p
              class="font-[var(--weight-display)]"
              style={`font-family: var(--font-display); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-strong);`}
            >
              Slightly Lost
            </p>
            <p style={`font-family: var(--font-display); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-body); font-weight: 400;`}>
              {pangram}
            </p>
          </div>
        ))
      }
      <div style="border-top: 1px solid var(--color-hairline); padding: 1rem 0;">
        <p style="font-family: var(--font-display); font-size: var(--text-body-l); line-height: var(--text-body-l--line-height); color: var(--color-text-strong); font-weight: 400;">
          Slightly Lost
        </p>
        <p style="font-family: var(--font-display); font-size: var(--text-body-l); line-height: var(--text-body-l--line-height); color: var(--color-text-body); font-weight: 400; font-style: italic;">
          {pangram}
        </p>
      </div>

      <h2 style="font-family: var(--font-ui); font-weight: 600; color: var(--color-text-strong); margin-top: 2rem;">Inter Tight</h2>
      {
        interTightLevels.map((level) => (
          <div style="border-top: 1px solid var(--color-hairline); padding: 1rem 0;">
            <p style={`font-family: var(--font-ui); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-strong);`}>
              Slightly Lost
            </p>
            <p style={`font-family: var(--font-ui); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-body);`}>
              {pangram}
            </p>
          </div>
        ))
      }

      <h2 style="font-family: var(--font-ui); font-weight: 600; color: var(--color-text-strong); margin-top: 2rem;">IBM Plex Mono</h2>
      {
        plexMonoLevels.map((level) => (
          <div style="border-top: 1px solid var(--color-hairline); padding: 1rem 0;">
            <p style={`font-family: var(--font-mono); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-strong);`}>
              Slightly Lost
            </p>
            <p style={`font-family: var(--font-mono); font-size: var(--text-${level.token}); line-height: var(--text-${level.token}--line-height); color: var(--color-text-body); font-variant-numeric: tabular-nums;`}>
              {sampleData}
            </p>
          </div>
        ))
      }
    </section>
  </div>
</Layout>
