---
import Base from '@/layouts/Base.astro'
import Label from '@/components/primitives/Label.astro'
import Hairline from '@/components/primitives/Hairline.astro'
import AtlasMap from '@/components/atlas/AtlasMap.astro'
import { atlas, atlasKindBySlug, atlasStatusBySlug } from '@/config'
import { getLocatedAtlasEntries, getPublishedAtlasEntries } from '@/lib/atlas'

// A minimal atlas index, enough to host the map island and give it the list
// it is an enhancement over. The full catalogue, the filters, and the
// compact AtlasCard variant replace the plain list below in the atlas index
// prompt.
const publishedEntries = [...(await getPublishedAtlasEntries())].sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
)
const locatedEntries = getLocatedAtlasEntries(publishedEntries)
---

<Base type="website" title={atlas.label} description={atlas.title} surface="ink">
  <div class="max-w-content mx-auto flex flex-col gap-16 px-6 py-16 md:py-(--spacing-section)">
    <div class="flex flex-col gap-6">
      <Label accentRule>{atlas.label}</Label>
      <h1
        class="font-display text-display-l text-text-strong"
        style="font-weight: var(--weight-display)"
      >
        {atlas.title}
      </h1>
      <p class="max-w-measure font-display text-body-l text-text-muted">{atlas.intro}</p>
      <Hairline class="mt-2" />
    </div>

    <AtlasMap entries={locatedEntries} />

    <section aria-labelledby="atlas-list" class="flex flex-col gap-6">
      <!-- The map's skip link and its Escape key both land here. -->
      <h2
        id="atlas-list"
        tabindex="-1"
        class="font-display text-display-m text-text-strong"
        style="font-weight: var(--weight-display)"
      >
        {atlas.listHeading}
      </h2>
      <ul class="border-hairline flex flex-col border-b">
        {
          publishedEntries.map((entry) => (
            <li class="border-hairline flex flex-wrap items-baseline gap-x-6 gap-y-1 border-t py-4">
              <span class="text-label text-sage font-mono uppercase">
                {atlasKindBySlug[entry.data.kind].name}
              </span>
              <a
                href={entry.data.href}
                class="font-display text-title text-text-strong hover:text-accent motion-safe:transition-colors"
              >
                {entry.data.name}
              </a>
              <span class="text-label text-text-muted font-mono uppercase">
                {atlasStatusBySlug[entry.data.status].name}
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
