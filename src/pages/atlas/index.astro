---
import Base from '@/layouts/Base.astro'
import Label from '@/components/primitives/Label.astro'
import AtlasFilters from '@/components/atlas/AtlasFilters.astro'
import AtlasMap from '@/components/atlas/AtlasMap.astro'
import AtlasCatalogue from '@/components/atlas/AtlasCatalogue.astro'
import { atlas } from '@/config'
import { getLocatedAtlasEntries, getPublishedAtlasEntries } from '@/lib/atlas'

// The atlas index. The catalogue is the atlas: every published entry,
// server-rendered and readable without JavaScript. The filters and the map
// are enhancements over it, and both are absent rather than inert without
// JavaScript.
const publishedEntries = [...(await getPublishedAtlasEntries())].sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
)
const locatedEntries = getLocatedAtlasEntries(publishedEntries)
---

<Base type="website" title={atlas.label} description={atlas.description} surface="ink">
  <!-- data-atlas-filter is the filter state: AtlasFilters.script.ts writes it
       and the map island reads it when it mounts. -->
  <div
    data-atlas-index
    data-atlas-filter="all"
    class="max-w-content mx-auto flex flex-col gap-10 px-6 py-16 md:py-(--spacing-section)"
  >
    <div class="mb-6 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end lg:gap-x-16">
      <div class="flex flex-col gap-8 lg:col-span-7">
        <Label accentRule>{atlas.label}</Label>
        <h1
          class="font-display text-display-l text-text-strong"
          style="font-weight: var(--weight-display)"
        >
          {atlas.title}
        </h1>
      </div>
      <p class="max-w-measure font-display text-body-l text-text-body lg:col-span-5">
        {atlas.intro}
      </p>
    </div>

    <AtlasFilters entries={publishedEntries} />

    <AtlasMap entries={locatedEntries} />

    <AtlasCatalogue entries={publishedEntries} />
  </div>
</Base>
