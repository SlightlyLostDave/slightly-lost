---
import Base from './Base.astro'
import Prose from '@/components/primitives/Prose.astro'
import Label from '@/components/primitives/Label.astro'
import Hairline from '@/components/primitives/Hairline.astro'
import { pillarBySlug, type PillarSlug } from '@/config/pillars'
import { site } from '@/config'

interface Props {
  title: string
  description: string
  openGraphImage?: string
  canonicalUrl?: string
  noindex?: boolean
  publishedAt: Date
  updatedAt?: Date
  authorName?: string
  surface?: 'paper' | 'ink'
  headerState?: 'transparent' | 'solid'
  pillar: PillarSlug
  region: string
  readingTime: number
  photoCount: number
}

const {
  title,
  description,
  openGraphImage,
  canonicalUrl,
  noindex,
  publishedAt,
  updatedAt,
  authorName,
  surface = 'ink',
  headerState = 'solid',
  pillar,
  region,
  readingTime,
  photoCount,
} = Astro.props

const pillarData = pillarBySlug[pillar]
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(publishedAt)
---

<Base
  type="article"
  title={title}
  description={description}
  openGraphImage={openGraphImage}
  canonicalUrl={canonicalUrl}
  noindex={noindex}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  authorName={authorName}
  surface={surface}
  headerState={headerState}
>
  <article>
    {
      headerState === 'solid' && (
        // Header.astro's own root is also `fixed inset-x-0 top-0 z-50`. This
        // track doesn't push the header down (that would mean editing the
        // shared Header component) — it overlays the header's top 2px of
        // background instead. That paints correctly with no z-index bump:
        // this markup renders inside <main>, after <Header> in Base.astro's
        // DOM order, and for elements at equal z-50, later DOM order wins
        // the paint. The header has no border/content in that top sliver
        // (its only border is border-b), so the overlay reads identically
        // to a version that pushed the header down by 2px.
        <div
          data-anim="article"
          aria-hidden="true"
          class="fixed inset-x-0 top-0 z-50 h-0.5 bg-hairline motion-reduce:hidden"
        >
          {
            /* transform (not Tailwind's scale-x-0, which sets the standalone
               `scale` CSS property) so the resting state and Article.motion.ts's
               GSAP scaleX tween compose on the same property, matching
               Header.astro's own documented reasoning for its transform-only
               elements. */
          }
          <div
            class="progress__fill h-full w-full origin-left bg-accent"
            style="transform: scaleX(0)"
          />
        </div>
      )
    }

    <div class="max-w-content mx-auto px-6 pt-16">
      <div data-anim="reveal" class="flex max-w-(--container-measure) flex-col gap-6">
        <Label accentRule>{pillarData.name} / {region}</Label>
        <h1 class="font-display text-display-l text-text-strong">{title}</h1>
        <p class="font-display text-body-l text-text-muted">{description}</p>
        <Hairline class="mt-2" />
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 font-mono text-label text-text-muted wrap-break-word">
          <span class="text-text-body">{authorName ?? site.author.name}</span>
          <span aria-hidden="true">/</span>
          <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
          <span aria-hidden="true">/</span>
          <span>{readingTime} min</span>
          <span aria-hidden="true">/</span>
          <span>{photoCount} photograph{photoCount === 1 ? '' : 's'}</span>
        </div>
      </div>
    </div>

    <div class="mt-(--spacing-section)">
      <slot name="hero" />
    </div>

    <slot name="field-data" />

    <div class="max-w-content mx-auto mt-(--spacing-section) px-6" data-article-body>
      <Prose>
        <slot />
      </Prose>
    </div>

    <slot name="series-nav" />
    <slot name="tags" />

    <slot name="sources" />

    <div class="max-w-content mx-auto mt-(--spacing-section) px-6">
      <slot name="related" />
    </div>
  </article>
</Base>
