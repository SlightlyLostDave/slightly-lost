---
import type { CollectionEntry } from 'astro:content'
import type { Page } from 'astro'
import Base from './Base.astro'
import Label from '@/components/primitives/Label.astro'
import Hairline from '@/components/primitives/Hairline.astro'
import PostGrid from '@/components/sections/PostGrid.astro'

interface Props {
  title: string
  description: string
  label: string
  openGraphImage?: string
  canonicalUrl?: string
  noindex?: boolean
  surface?: 'paper' | 'ink'
  headerState?: 'transparent' | 'solid'
  entries: CollectionEntry<'posts'>[]
  page: Page<CollectionEntry<'posts'>>
  basePath: string
}

const {
  title,
  description,
  label,
  openGraphImage,
  canonicalUrl,
  noindex,
  surface = 'ink',
  headerState = 'solid',
  entries,
  page,
  basePath,
} = Astro.props
---

<Base
  type="website"
  title={title}
  description={description}
  openGraphImage={openGraphImage}
  canonicalUrl={canonicalUrl}
  noindex={noindex}
  surface={surface}
  headerState={headerState}
>
  <div class="max-w-content mx-auto flex flex-col gap-16 px-6 py-16 md:py-(--spacing-section)">
    <div class="flex flex-col gap-6">
      <Label accentRule>{label}</Label>
      <h1 class="font-display text-display-l text-text-strong" style="font-weight: var(--weight-display)">
        {title}
      </h1>
      {Astro.slots.has('intro') && (
        <p class="font-display text-body-l text-text-muted">
          <slot name="intro" />
        </p>
      )}
      <Hairline class="mt-2" />
    </div>

    <slot />

    <PostGrid entries={entries} page={page} basePath={basePath} />
  </div>
</Base>
