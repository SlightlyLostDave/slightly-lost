---
import type { PostBody } from '@/content.config'
import { serializeBlocks } from '@/lib/blocks'
import { getPublishedAtlasEntries, type PublishedAtlasEntry } from '@/lib/atlas'
import Prose from '@/components/primitives/Prose.astro'
import Figure from '@/components/media/Figure.astro'
import FigureGrid from '@/components/media/FigureGrid.astro'
import PullQuote from '@/components/sections/PullQuote.astro'
import AtlasReference from '@/components/atlas/AtlasReference.astro'

interface Props {
  body: PostBody[]
}

const { body } = Astro.props

function mergeRichTextRuns(blocks: PostBody[]): PostBody[] {
  const merged: PostBody[] = []
  for (const block of blocks) {
    const previous = merged.at(-1)
    if (block.component === 'body.rich-text' && previous?.component === 'body.rich-text') {
      merged[merged.length - 1] = { ...previous, content: [...previous.content, ...block.content] }
    } else {
      merged.push(block)
    }
  }
  return merged
}

function assertNever(value: never): never {
  throw new Error(`ArticleBody: unhandled body component "${JSON.stringify(value)}"`)
}

const mergedBody = mergeRichTextRuns(body)
const firstRichTextIndex = mergedBody.findIndex((block) => block.component === 'body.rich-text')

// Through the published-entries choke point, so a reference to a draft entry
// renders nothing rather than linking to it. Only fetched when the body has
// a reference to resolve.
const hasAtlasReference = mergedBody.some((block) => block.component === 'body.atlas-reference')
const publishedAtlasEntryById = new Map<string, PublishedAtlasEntry>(
  hasAtlasReference ? (await getPublishedAtlasEntries()).map((entry) => [entry.id, entry]) : []
)
---

{
  mergedBody.map((block, index) => {
    switch (block.component) {
      case 'body.rich-text':
        return (
          <Prose>
            <Fragment
              set:html={serializeBlocks(block.content, {
                lede: index === firstRichTextIndex,
                firstBlock: index === 0,
              })}
            />
          </Prose>
        )
      case 'body.figure':
        return (
          <Figure
            src={block.image.src}
            alt={block.image.alt}
            imgWidth={block.image.width}
            imgHeight={block.image.height}
            caption={block.caption}
            width={block.width}
          />
        )
      case 'body.figure-grid':
        return (
          <FigureGrid columns={block.columns}>
            {block.images.map((image) => (
              <Figure
                src={image.src}
                alt={image.alt}
                imgWidth={image.width}
                imgHeight={image.height}
                caption={image.caption}
                gridColumns={block.columns}
              />
            ))}
          </FigureGrid>
        )
      case 'body.pull-quote':
        return <PullQuote>{block.quote}</PullQuote>
      case 'body.atlas-reference': {
        const atlasEntry = publishedAtlasEntryById.get(block.atlasEntry.id)
        if (!atlasEntry) return null
        // textAfter follows the chip directly, so it can open with punctuation.
        return (
          <Prose>
            <p data-first={index === 0 || undefined}>
              {block.textBefore && <>{block.textBefore} </>}
              <AtlasReference entry={atlasEntry} />
              {block.textAfter}
            </p>
          </Prose>
        )
      }
      default:
        return assertNever(block)
    }
  })
}
