---
import { Picture } from 'astro:assets'
import Tag from '@/components/primitives/Tag.astro'
import Hairline from '@/components/primitives/Hairline.astro'
import Placeholder from '@/components/media/Placeholder.astro'
import { pillarBySlug, type PillarSlug } from '@/config/pillars'

export interface PostCardData {
  pillar: PillarSlug
  title: string
  dek: string
  publishedAt: Date
  readingTime: number
  href: string
  imageAlt: string
  image?: { src: string; width: number; height: number; alt: string }
}

interface Props {
  post: PostCardData
  aspect?: '3:2' | '4:5' | '1:1'
  textOnly?: boolean
  placeholderVariant?: 'a' | 'b' | 'c' | 'd'
}

const { post, aspect = '3:2', textOnly = false, placeholderVariant = 'a' } = Astro.props

const pillar = pillarBySlug[post.pillar]

const aspectClasses: Record<NonNullable<Props['aspect']>, string> = {
  '3:2': 'aspect-card-wide',
  '4:5': 'aspect-card-portrait',
  '1:1': 'aspect-square',
}

// 2x the card's real rendered width at each aspect, so AVIF/WebP stay crisp
// at typical device pixel ratios. Astro's image service crops to match
// (never distorts) and never upscales past the source's own resolution.
const cropDimensions: Record<NonNullable<Props['aspect']>, { width: number; height: number }> = {
  '3:2': { width: 900, height: 600 },
  '4:5': { width: 800, height: 1000 },
  '1:1': { width: 800, height: 800 },
}

// Matches RecentNotes.astro's grid: max-w-content (1376px), px-6 (24px),
// gap-6 (24px), md:grid-cols-3. Keep in sync by hand if that grid changes.
const cardSizes =
  '(min-width: 1424px) 443px, (min-width: 768px) calc((100vw - 96px) / 3), calc(100vw - 48px)'

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
})
  .format(post.publishedAt)
  .replaceAll('/', '.')
---

<a
  href={post.href}
  aria-label={post.title}
  class="group flex flex-col gap-5 border border-hairline bg-surface-raised motion-safe:transition-colors hover:border-rule-strong focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4"
>
  {
    !textOnly && (
      <div class:list={['relative overflow-hidden bg-surface', aspectClasses[aspect]]}>
        {
          post.image ? (
            <Picture
              src={post.image.src}
              alt=""
              width={cropDimensions[aspect].width}
              height={cropDimensions[aspect].height}
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              sizes={cardSizes}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          ) : (
            <Placeholder variant={placeholderVariant} />
          )
        }
        <Tag label={pillar.name} onImage class="absolute top-3 left-3" />
      </div>
    )
  }

  <div class="flex flex-1 flex-col gap-5 p-6">
    <span class="font-mono text-label uppercase text-sage">{pillar.name}</span>

    <h3
      class="font-display text-display-m text-text-strong underline decoration-1 decoration-transparent underline-offset-4 group-hover:decoration-accent group-focus-visible:decoration-accent"
      style="font-weight: var(--weight-display)"
    >
      {post.title}
    </h3>

    <p class="line-clamp-2 flex-1 text-body text-text-muted">{post.dek}</p>

    <Hairline />

    <div class="flex items-center justify-between font-mono text-data tabular-nums text-text-muted">
      <span>{formattedDate}</span>
      <span>{post.readingTime} min</span>
    </div>
  </div>
</a>
