---
import { Picture } from 'astro:assets'
import Placeholder from '@/components/media/Placeholder.astro'
import type { Pillar } from '@/config/pillars'

interface Props {
  pillar: Pillar
  count: number
}

const { pillar, count } = Astro.props

const placeholderVariants = ['a', 'b', 'c', 'd'] as const
const placeholderVariant = placeholderVariants[Number(pillar.number) % placeholderVariants.length]
---

<section
  data-hero
  class:list={[
    /* calc(50% - 50vw) breaks this element out of any centered ancestor to true
       viewport edges, matching FullBleed.astro's documented breakout formula.
       No @theme token fits a one-off hero height, so h-[70svh]/h-[720px] are
       arbitrary values: 70svh keeps the hero from swallowing the whole
       viewport on short mobile screens, md:h-[720px] matches the design. */
    'relative mx-[calc(50%-50vw)] h-[70svh] w-auto overflow-hidden md:h-[720px]',
  ]}
>
  {
    pillar.image ? (
      <Picture
        src={pillar.image.src}
        alt={pillar.image.alt}
        width={pillar.image.width}
        height={pillar.image.height}
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
    ) : (
      <div class="absolute inset-0" aria-hidden="true">
        <Placeholder variant={placeholderVariant} />
      </div>
    )
  }

  <!-- Scrim so text-text-strong/text-text-body stay legible over any hero
       image in either theme, matching Hero.astro's after:bg-surface/70 scrim. -->
  <div class="absolute inset-0 bg-surface/70" aria-hidden="true"></div>

  <div
    aria-hidden="true"
    class="absolute top-6 left-6 font-mono text-label uppercase text-text-muted md:top-10 md:left-10"
    style="writing-mode: vertical-rl; transform: rotate(180deg)"
  >
    Pillar {pillar.number} / {count} dispatch{count === 1 ? '' : 'es'}
  </div>

  <div class="absolute right-6 bottom-8 left-6 md:right-24 md:bottom-16 md:left-24">
    <h1
      class="font-display text-display-xl text-text-strong"
      style="font-weight: var(--weight-display)"
    >
      {pillar.name}
    </h1>
    <p class="mt-4 max-w-measure font-display text-body-l text-text-body md:mt-7">
      {pillar.description}
    </p>
  </div>
</section>
