---
interface Props {
  as?: 'span' | 'h2' | 'h3' | 'h4'
  accentRule?: boolean
  class?: string
}

const { as: Tag = 'span', accentRule = false, class: className } = Astro.props
---

<Tag
  class:list={[
    'inline-flex items-center gap-2 font-mono text-label uppercase text-text-muted',
    className,
  ]}
>
  {accentRule && <span aria-hidden="true" class="h-px w-4 bg-accent"></span>}
  <slot />
</Tag>
