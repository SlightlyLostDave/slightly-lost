---
// Flat vector stand-in for a photograph that does not exist yet. Five
// stacked bands (sky / far ridge / mid ground / near ground / foreground)
// drawn from four consecutive windows of the fixed photo-1..8 tones in
// @theme (src/styles/app.css), which never change with the theme because a
// photograph would not. fill="currentColor" resolves each rect's own text-*
// utility. Delete this file and pass a real `src` at each Figure/FullBleed
// call site once photography exists; no other component changes needed.
interface Props {
  variant?: 'a' | 'b' | 'c' | 'd'
  class?: string
}

const { variant = 'a', class: className } = Astro.props

const bandsByVariant: Record<NonNullable<Props['variant']>, string[]> = {
  a: ['text-photo-1', 'text-photo-2', 'text-photo-3', 'text-photo-4', 'text-photo-5'],
  b: ['text-photo-2', 'text-photo-3', 'text-photo-4', 'text-photo-5', 'text-photo-6'],
  c: ['text-photo-3', 'text-photo-4', 'text-photo-5', 'text-photo-6', 'text-photo-7'],
  d: ['text-photo-4', 'text-photo-5', 'text-photo-6', 'text-photo-7', 'text-photo-8'],
}
const bands = bandsByVariant[variant]
---

<svg
  viewBox="0 0 100 75"
  preserveAspectRatio="none"
  role="presentation"
  aria-hidden="true"
  class:list={['block h-full w-full', className]}
>
  {bands.map((tone, i) => <rect x="0" y={i * 15} width="100" height="15" class={tone} fill="currentColor" />)}
</svg>
