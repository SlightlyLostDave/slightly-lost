---
import { getImage } from 'astro:assets'

interface Props {
  src?: string
  alt: string
  width?: number
  height?: number
  displayHeight?: string
  caption?: string
  class?: string
}

const { src, alt, width, height, displayHeight = '70vh', caption, class: className } = Astro.props

// Art-directed hero crops: 4:5 portrait below 768px, 3:2 landscape at 768px
// and above - matches the site's md breakpoint used everywhere else
// (HeroLayer.astro, RecentNotes.astro). Raw px because CSS media queries
// can't read Tailwind's --breakpoint-md custom property; keep in sync by
// hand if that changes.
const MOBILE_CROP = { width: 960, height: 1200 } as const // 4:5
const DESKTOP_CROP = { width: 2400, height: 1600 } as const // 3:2

const [mobileAvif, mobileWebp, desktopAvif, desktopWebp, desktopFallback] =
  src && width && height
    ? await Promise.all([
        getImage({ src, ...MOBILE_CROP, format: 'avif' }),
        getImage({ src, ...MOBILE_CROP, format: 'webp' }),
        getImage({ src, ...DESKTOP_CROP, format: 'avif' }),
        getImage({ src, ...DESKTOP_CROP, format: 'webp' }),
        getImage({ src, ...DESKTOP_CROP, format: 'jpeg' }),
      ])
    : []
---

<figure
  data-hero
  style={`height: ${displayHeight}`}
  class:list={[
    /* calc(50% - 50vw) breaks this element out of any centered ancestor to
       true viewport edges. Deliberately not width:100vw + left-1/2/
       -translate-x-1/2: 100vw includes the scrollbar gutter on some
       browsers/OSes, which can itself introduce the horizontal scrollbar
       this component must avoid. A structural breakout formula, not a
       design value — no token fits. */
    'relative mx-[calc(50%-50vw)] w-auto overflow-hidden',
    className,
  ]}
>
  {
    mobileAvif && mobileWebp && desktopAvif && desktopWebp && desktopFallback ? (
      <picture>
        <source media="(max-width: 767.98px)" srcset={mobileAvif.src} type="image/avif" />
        <source media="(max-width: 767.98px)" srcset={mobileWebp.src} type="image/webp" />
        <source media="(min-width: 768px)" srcset={desktopAvif.src} type="image/avif" />
        <source media="(min-width: 768px)" srcset={desktopWebp.src} type="image/webp" />
        <img
          src={desktopFallback.src}
          alt={alt}
          width={desktopFallback.attributes.width}
          height={desktopFallback.attributes.height}
          class="h-full w-full object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    ) : (
      <div role="img" aria-label={alt} class="h-full w-full">
        <slot name="media" />
      </div>
    )
  }
  {
    caption && (
      <figcaption class="absolute bottom-4 left-6 max-w-[80%] bg-ink/70 px-2 py-1 font-mono text-caption text-paper wrap-break-word">
        {caption}
      </figcaption>
    )
  }
</figure>
