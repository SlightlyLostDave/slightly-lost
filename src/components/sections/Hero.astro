---
import Label from '@components/primitives/Label.astro'
import HeroLayer from '@components/sections/HeroLayer.astro'
import { homepage } from '@/config'

const { hero } = homepage;
---

<!--
  Stage height = one pinned "screen" (100svh, matches data-hero-screen's own
  h-svh below) plus a 140svh runway: 40svh of pure dwell (the pinned scene
  plays out undisturbed, as before) followed by a 100svh cover-transition
  window during which Interstitial (pulled up by its own -mt-[100svh], see
  Interstitial.astro) rises from fully below the viewport to fully covering
  it, entirely while this screen box is still stuck. 100svh is not
  arbitrary: it's the exact scroll distance a full-viewport-height sibling
  takes to slide from "just below the viewport" to "fully covering it," so
  matching the transition window to one screen-height is what makes the
  cover finish exactly as this screen box unsticks (240 - 100 = 140, this
  stage's own runway) -- shorter and Interstitial would still be mid-slide
  after unsticking (a jarring double-render), longer and there'd be dead
  scroll with Interstitial already fully covering but the screen box still
  technically stuck underneath it. svh on every term, not vh, so the whole
  relationship stays proportionally correct as mobile browser chrome
  shows/hides. No @theme token fits a one-off viewport-relative stage height
  used exactly once. Keep 240/100/140 in sync by hand with
  Hero.motion.ts's SCREEN_VH/RUNWAY_VH and Interstitial.astro's -mt-[100svh],
  the same pattern app.css documents for --header-height-tall /
  Header.motion.ts. motion-reduce:h-svh collapses the stage back to a normal
  one-screen section -- the pin itself is scroll-linked motion, not just the
  parallax, so it's gated behind prefers-reduced-motion too.
-->
<section data-hero data-anim="hero" class="relative h-[240svh] w-full motion-reduce:h-svh">
  <div
    data-hero-screen
    class="bg-surface sticky top-0 h-svh w-full overflow-hidden motion-reduce:static after:absolute after:inset-0 after:bg-surface/70"
  >
    <HeroLayer layer="back" />
    <HeroLayer layer="mid" />
    <!--
      fetchpriority="high" and explicit width/height were originally specified
      for this (LCP-candidate) layer with a real <img> in mind. fetchpriority
      only applies to fetchable elements (img/link/script/iframe) -- this is
      inline SVG with no network request, so there is no target for it.
      Re-add both, exactly as originally specified, on whatever <img> replaces
      HeroPlaceholder's "mid" branch once real photography exists.
    -->

    <div
      data-hero-layer="type"
      class="relative z-20 flex h-full w-full flex-col justify-between px-6 py-10 md:px-10 md:py-14"
    >
      <div class="max-w-content mx-auto my-auto flex w-full flex-col gap-6">
        <Label accentRule>{hero.kicker}</Label>
        <h1 class="font-display text-display-xl text-text-strong font-(--weight-display)">
          {hero.headline}
        </h1>
        <p class="max-w-measure font-display text-body-l text-text-body">{hero.subhead}</p>
      </div>

      <div
        class="max-w-content border-hairline text-label text-text-muted mx-auto flex w-full items-end justify-between gap-4 border-t pt-4 font-mono uppercase"
      >
        <div class="flex flex-col gap-1">
          <span>{hero.coordinates}</span>
          <span>{hero.place}</span>
        </div>
        <div class="flex items-center gap-2">
          <span>Scroll</span>
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path
              d="M10 3v13M4.5 11.5 10 17l5.5-5.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </div>
      </div>
    </div>

    <!--
      absolute inset-0, not a second sticky sibling: a sibling position:sticky
      box would add its own h-svh of document-flow height on top of this
      screen box's, leaving no room within the 140svh stage for the intended
      40svh runway (confirmed by measuring computed positions -- the second
      sticky box never actually reached top:0). Nesting front here instead
      means it takes zero flow height (absolute is out-of-flow) and inherits
      this screen box's own sticky pin for free, since data-hero-screen
      (position: sticky) is a valid containing block for an absolute child.
      z-10, not z-index:auto: guarantees this layer paints above Interstitial
      (position: static) regardless of nesting, since neither this screen box
      nor the outer stage establishes its own stacking context (z-index:auto,
      no transform/opacity/filter), so z-10 bubbles up to the root stacking
      context where an explicit positive z-index always outranks
      z-index:auto/static elements. This is what keeps the foreground
      silhouette visible in front of Interstitial during the brief overlap
      where GSAP's scrub lag means front is still visibly translating right
      as the screen box's sticky range ends. Keep this the highest explicit
      z-index below the header's z-50. hidden md:motion-safe:block, not
      hidden md:block plus a separate motion-reduce:hidden: two independent
      classes with equal selector specificity (md:block vs
      motion-reduce:hidden) would leave the md+reduced-motion case decided by
      Tailwind's internal variant sort order rather than an explicit rule.
      Stacking the variants on one utility (only show at md+ when motion is
      NOT reduced) is unambiguous: front is purely decorative (aria-hidden in
      HeroPlaceholder.astro), so it simply stays hidden under reduced motion
      at every breakpoint.
    -->
    <div
      data-hero-foreground
      class="pointer-events-none absolute inset-0 hidden overflow-hidden md:motion-safe:block"
    >
      <HeroLayer layer="front" />
    </div>
  </div>
</section>
