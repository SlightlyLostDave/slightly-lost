---
import Label from '@/components/primitives/Label.astro'
import HeroPlaceholder from './HeroPlaceholder.astro'
import { homepage } from '@/config'

const { hero } = homepage
---

<!--
  Stage height = one pinned "screen" (100svh, matches data-hero-screen's own
  h-svh below) plus a 40svh scroll runway the pinned curtain plays out
  across before Interstitial takes over. svh on both terms, not vh, so the
  runway stays proportionally correct as mobile browser chrome shows/hides
  -- mixing units would let the two drift apart. No @theme token fits a
  one-off viewport-relative stage height used exactly once. Keep 140/100/40
  in sync by hand with Hero.motion.ts's SCREEN_VH/RUNWAY_VH, the same
  pattern app.css documents for --header-height-tall / Header.motion.ts.
  motion-reduce:h-svh collapses the stage back to a normal one-screen
  section -- the pin itself is scroll-linked motion, not just the parallax,
  so it's gated behind prefers-reduced-motion too.
-->
<section data-hero data-anim="hero" class="relative h-[140svh] w-full motion-reduce:h-svh">
  <div
    data-hero-screen
    class="bg-surface sticky top-0 h-svh w-full overflow-hidden motion-reduce:static"
  >
    <HeroPlaceholder layer="back" />
    <HeroPlaceholder layer="mid" />
    <!--
      fetchpriority="high" and explicit width/height were originally specified
      for this (LCP-candidate) layer with a real <img> in mind. fetchpriority
      only applies to fetchable elements (img/link/script/iframe) -- this is
      inline SVG with no network request, so there is no target for it.
      Re-add both, exactly as originally specified, on whatever <img> replaces
      HeroPlaceholder's "mid" branch once real photography exists.
    -->

    <div
      data-hero-layer="type"
      class="relative flex h-full w-full flex-col justify-between px-6 py-10 md:px-10 md:py-14"
    >
      <div class="max-w-content mx-auto my-auto flex w-full flex-col gap-6">
        <Label accentRule>{hero.kicker}</Label>
        <h1 class="font-display text-display-xl text-text-strong font-(--weight-display)">
          {hero.headline}
        </h1>
        <p class="max-w-measure font-display text-body-l text-text-body">{hero.subhead}</p>
      </div>

      <div
        class="max-w-content border-hairline text-label text-text-muted mx-auto flex w-full items-end justify-between gap-4 border-t pt-4 font-mono uppercase"
      >
        <div class="flex flex-col gap-1">
          <span>{hero.coordinates}</span>
          <span>{hero.place}</span>
        </div>
        <div class="flex items-center gap-2">
          <span>Scroll</span>
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path
              d="M10 3v13M4.5 11.5 10 17l5.5-5.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!--
    z-10, not z-index:auto: guarantees this box paints above Interstitial
    (position: static) AND above the screen box above (position: sticky,
    z-index: auto) regardless of DOM order, since an explicit positive
    z-index always outranks z-index:auto/static siblings in the same
    stacking context. This is what keeps the foreground silhouette visible
    in front of Interstitial during the brief overlap where GSAP's scrub
    lag means front is still visibly translating right as the screen box's
    sticky range ends. Keep this the highest explicit z-index below the
    header's z-50. hidden md:motion-safe:block, not hidden md:block plus a
    separate motion-reduce:hidden: two independent classes with equal
    selector specificity (md:block vs motion-reduce:hidden) would leave the
    md+reduced-motion case decided by Tailwind's internal variant sort
    order rather than an explicit rule. Stacking the variants on one
    utility (only show at md+ when motion is NOT reduced) is unambiguous:
    front is purely decorative (aria-hidden in HeroPlaceholder.astro), so
    it simply stays hidden under reduced motion at every breakpoint,
    avoiding an orphaned near-empty h-svh box in flow between the screen
    box and Interstitial.
  -->
  <div
    data-hero-foreground
    class="pointer-events-none sticky top-0 z-10 hidden h-svh w-full overflow-hidden md:motion-safe:block"
  >
    <HeroPlaceholder layer="front" />
  </div>
</section>
