---
import Button from '@/components/primitives/Button.astro'
import { homepage } from '@/config'

const { newsletter: heading } = homepage.sectionHeadings
const { newsletter } = homepage
---

<section class="bg-surface px-6 py-16 md:py-(--spacing-section)">
  <div class="max-w-content mx-auto grid grid-cols-1 gap-16 md:grid-cols-2 md:gap-20">
    <h2 class="font-display text-display-l text-text-strong" style="font-weight: var(--weight-display)">
      {heading}
    </h2>

    <div class="flex flex-col gap-6 md:pt-2">
      <p class="max-w-measure text-body text-text-muted">
        No schedule, no growth strategy, no sponsored anything. If a month is quiet you will not hear from me.
      </p>

      {/* Posts nowhere yet: no newsletter provider is wired up. Swap the action once one is. */}
      <form action="#newsletter-placeholder" method="post" class="flex flex-col gap-3">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <div class="flex flex-wrap items-center gap-3">
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@wherever"
            aria-describedby="newsletter-fine-print"
            class="h-(--control-height) min-w-0 flex-1 border border-hairline bg-surface-raised px-4 text-body text-text-strong focus-visible:border-rule-strong focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
          />
          <Button type="submit" variant="primary">Send it</Button>
        </div>
        <p id="newsletter-fine-print" class="font-mono text-label uppercase text-text-subtle">
          {newsletter.finePrint}
        </p>
      </form>
    </div>
  </div>
</section>
