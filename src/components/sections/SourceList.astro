---
import Label from '@/components/primitives/Label.astro'

interface Props {
  sources: { citation: string; note?: string }[]
  class?: string
}

const { sources, class: className } = Astro.props
---

<section class:list={['bg-surface-raised px-6 py-24', className]}>
  <div class="max-w-content mx-auto">
    <Label as="h2" accentRule>Sources</Label>
    <ol class="mt-6 list-none divide-y divide-hairline border-t border-hairline">
      {
        sources.map((source, i) => (
          <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-baseline gap-4 py-4">
            <span aria-hidden="true" class="font-mono text-data leading-none text-text-muted">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <p class="font-display text-body text-text-strong wrap-break-word">{source.citation}</p>
              {source.note && <p class="mt-1 font-mono text-caption text-text-muted wrap-break-word">{source.note}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
