---
import Label from '@/components/primitives/Label.astro'
import DataValue from '@/components/primitives/DataValue.astro'
import Hairline from '@/components/primitives/Hairline.astro'
import Button from '@/components/primitives/Button.astro'
import Placeholder from '@/components/media/Placeholder.astro'
import { homepage } from '@/config'
import { getPublishedPosts } from '@/lib/posts'

const { featuredDispatch } = homepage
const { statLabels } = featuredDispatch

// The numbers come from the post itself, as the loader computed them for its
// article page, so the two cannot disagree. An unpublished or missing post
// leaves the row out rather than showing zeroes.
const featuredPost = (await getPublishedPosts()).find(
  (post) => post.data.href === featuredDispatch.href
)

// The design writes this date day first, 14.08.2026. UTC, like
// formatAtlasDate, so the build machine's timezone cannot shift the day.
function formatDispatchDate(date: Date): string {
  const [year, month, day] = date.toISOString().slice(0, 10).split('-')
  return `${day}.${month}.${year}`
}
---

<section class="relative z-0 grid grid-cols-1 items-stretch md:grid-cols-2">
  <figure class="relative aspect-3/2 md:aspect-auto md:h-full">
    <div role="img" aria-label={featuredDispatch.imageAlt} class="h-full w-full overflow-hidden">
      <Placeholder variant="a" />
    </div>
    <!-- A caption over a photograph is the same in both themes: a dark island. -->
    <figcaption
      data-theme="dark"
      class="bg-surface/70 text-caption text-text-strong absolute bottom-4 left-6 px-2 py-1 font-mono wrap-break-word"
    >
      {featuredDispatch.imageCaption}
    </figcaption>
  </figure>

  <!-- 96px padding only from xl: at md/lg each column is half the viewport,
       and 96px a side left the headline about 190px to wrap in. -->
  <div class="bg-surface-raised flex flex-col justify-center gap-8 px-6 py-16 md:p-12 xl:p-24">
    <Label accentRule>{featuredDispatch.label}</Label>
    <h2 class="font-display text-display-l text-text-strong" style="font-weight: var(--weight-display)">
      {featuredDispatch.title}
    </h2>
    <p class="max-w-measure font-display text-body-l text-text-muted">
      {featuredDispatch.standfirst}
    </p>
    {
      featuredPost && (
        <>
          <Hairline />
          {/* Wraps instead of squashing: a fixed three-up row collided at 320 and 1024. */}
          <div class="flex flex-wrap gap-x-10 gap-y-6">
            <DataValue
              label={statLabels.published}
              value={formatDispatchDate(featuredPost.data.publishedAt)}
            />
            <DataValue
              label={statLabels.reading}
              value={String(featuredPost.data.readingTime)}
              unit={statLabels.readingUnit}
            />
            <DataValue
              label={statLabels.photographs}
              value={String(featuredPost.data.photoCount)}
            />
          </div>
        </>
      )
    }
    <Button href={featuredDispatch.href} variant="secondary">{featuredDispatch.ctaLabel}</Button>
  </div>
</section>
