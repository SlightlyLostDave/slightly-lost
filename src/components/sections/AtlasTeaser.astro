---
import Label from '@/components/primitives/Label.astro'
import Hairline from '@/components/primitives/Hairline.astro'
import Button from '@/components/primitives/Button.astro'
import { homepage, atlas as atlasConfig, atlasStatusBySlug, type AtlasMarker } from '@/config'
import { getLocatedAtlasEntries, getPublishedAtlasEntries } from '@/lib/atlas'
import { getAtlasStats } from '@/lib/atlas-stats'
import { fillTemplate } from '@/lib/atlas-filter'
import { fitToPlate } from '@/lib/geo'
import { primaryMarkerStatuses } from '@/lib/map-style'

const { atlas: heading } = homepage.sectionHeadings
const { atlas, atlasStats } = homepage

const publishedEntries = await getPublishedAtlasEntries()

// Counted from what the build loaded. Undefined below the threshold, and so
// always undefined for an empty atlas: the row is left out, never zeroed.
// The final value is the rendered text; AtlasTeaser.motion.ts counts up to it
// only once the script has run, so a failed script leaves the real number.
const stats = getAtlasStats(publishedEntries, atlasStats.minimumEntries)
const statRows = stats
  ? [
      { label: atlasStats.labels.entries, value: stats.entries },
      { label: atlasStats.labels.visited, value: stats.visited },
      { label: atlasStats.labels.withheld, value: stats.withheld },
    ]
  : []

const swatchClassByMarker: Record<AtlasMarker, string> = {
  primary: 'h-3 w-3 bg-accent',
  secondary: 'h-2 w-2 bg-sage',
}

// The plate is drawn from the same post-policy locations as atlas.geojson:
// getLocatedAtlasEntries leaves out every withheld entry, because the loader
// never gave one a location, and a fuzzed one arrives already rounded.
// fitToPlate returns whole SVG units, so no coordinate can be read back out
// of the markup. scripts/assert-atlas-policy.mjs checks every marker against
// the published GeoJSON.
const PLATE_WIDTH = 620
const PLATE_HEIGHT = 440
const PLATE_MARGIN = 32
const locatedEntries = getLocatedAtlasEntries(publishedEntries)
const platePoints = fitToPlate(
  locatedEntries.map((entry) => entry.data.location),
  PLATE_WIDTH,
  PLATE_HEIGHT,
  PLATE_MARGIN
)
const plateMarkers = locatedEntries
  .map((entry, index) => ({
    slug: entry.id,
    point: platePoints[index],
    isPrimary: primaryMarkerStatuses.includes(entry.data.status),
  }))
  // Primary markers draw last, above secondary ones where they overlap, as
  // on the atlas map.
  .sort((a, b) => Number(a.isPrimary) - Number(b.isPrimary))
const plateDescription = fillTemplate(atlas.plateDescription, {
  count: String(plateMarkers.length),
})

// Ruling for the plate, evenly spaced. Not a graticule: the lines mark no
// latitude or longitude.
const verticalRules = [124, 248, 372, 496]
const horizontalRules = [88, 176, 264, 352]
---

<!--
  md:grid-cols-[1fr_1.05fr]: the mockup gives the map plate a hair more
  width than the copy column. A one-off column ratio, no @theme token.
-->
<section class="bg-surface-raised px-6 py-16 md:py-(--spacing-section)">
  <div
    class:list={[
      'max-w-content mx-auto grid grid-cols-1 items-center gap-16 md:gap-20',
      plateMarkers.length > 0 && 'md:grid-cols-[1fr_1.05fr]',
    ]}
  >
    <div class="flex flex-col gap-8">
      <Label accentRule>{atlas.label}</Label>
      <h2 class="font-display text-display-l text-text-strong" style="font-weight: var(--weight-display)">
        {heading}
      </h2>
      <p class="max-w-measure font-display text-body-l text-text-muted">
        {atlas.intro}
      </p>
      {
        statRows.length > 0 && (
          <>
            <Hairline />
            <div data-anim="atlasStats" class="grid grid-cols-3 gap-6">
              {statRows.map((stat) => (
                <div class="flex flex-col gap-2">
                  <span
                    class="font-display text-display-l tabular-nums text-text-strong"
                    style="font-weight: var(--weight-display)"
                    data-count-to={stat.value}
                  >
                    {stat.value}
                  </span>
                  <span class="font-mono text-label uppercase text-text-muted">{stat.label}</span>
                </div>
              ))}
            </div>
          </>
        )
      }
      <Button href={atlas.href} variant="secondary" class="self-start">{atlas.ctaLabel}</Button>
    </div>

    {
      plateMarkers.length > 0 && (
        <div class="flex flex-col gap-4">
          {/* A map is an object on the page rather than part of it, so the plate
              keeps its own dark ground in both themes. See app.css. */}
          <div data-theme="dark" class="border border-hairline bg-surface p-6">
            <svg
              data-atlas-plate
              viewBox={`0 0 ${PLATE_WIDTH} ${PLATE_HEIGHT}`}
              class="block h-auto w-full"
              role="img"
              aria-label={plateDescription}
            >
              <g stroke="currentColor" stroke-width="1" class="text-hairline">
                {horizontalRules.map((offset) => (
                  <line x1="0" y1={offset} x2={PLATE_WIDTH} y2={offset} />
                ))}
                {verticalRules.map((offset) => (
                  <line x1={offset} y1="0" x2={offset} y2={PLATE_HEIGHT} />
                ))}
              </g>
              {plateMarkers.map((marker) => (
                <circle
                  data-atlas-plate-marker={marker.slug}
                  cx={marker.point.x}
                  cy={marker.point.y}
                  r={marker.isPrimary ? '8' : '4.5'}
                  fill="currentColor"
                  class={marker.isPrimary ? 'text-accent' : 'text-sage'}
                />
              ))}
            </svg>
          </div>

          <div class="flex flex-wrap gap-8 font-mono text-label uppercase text-text-muted">
            {atlasConfig.legend.map((item) => (
              <span class="flex items-center gap-2">
                <span aria-hidden="true" class:list={['block rounded-full', swatchClassByMarker[item.marker]]}></span>
                {atlasStatusBySlug[item.status].name}
              </span>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
