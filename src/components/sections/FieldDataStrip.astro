---
import DataValue from '@/components/primitives/DataValue.astro'
import type { FieldDataRow } from '@/lib/atlas'

// The data attributes are not styling hooks. scripts/assert-atlas-policy.mjs
// reads them in the built HTML to find coordinates typed into a post rather
// than taken from its atlas entry.
interface Props {
  items: FieldDataRow[]
  // The linked atlas entry, when the post is about one.
  atlasEntrySlug?: string
  class?: string
}

const { items, atlasEntrySlug, class: className } = Astro.props
---

<div data-field-data data-atlas-entry={atlasEntrySlug} class:list={['bg-surface-raised', className]}>
  <div class="max-w-content mx-auto grid grid-cols-2 gap-x-6 gap-y-6 px-6 py-6 md:grid-cols-5 md:gap-x-0 md:divide-x md:divide-hairline">
    {
      items.map((item) => (
        <div data-field-data-source={item.source} class="md:px-6 md:first:pl-0 md:last:pr-0">
          {item.accent ? (
            <div style="--color-text-strong: var(--color-accent)">
              <DataValue label={item.label} value={item.value} unit={item.unit} />
            </div>
          ) : (
            <DataValue label={item.label} value={item.value} unit={item.unit} />
          )}
        </div>
      ))
    }
  </div>
</div>
