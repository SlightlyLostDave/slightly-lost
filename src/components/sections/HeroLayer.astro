---
import { Image } from 'astro:assets';

import heroBackgroundImage from '@assets/home/hero-background.webp'
import heroMidgroundImage from '@assets/home/hero-midground.webp'
import heroForegroundImage from '@assets/home/hero-foreground.webp'

interface Props {
  layer: 'back' | 'mid' | 'front'
  class?: string
}

const { layer, class: className } = Astro.props;

const src = layer === 'back' ? heroBackgroundImage : layer === 'mid' ? heroMidgroundImage : heroForegroundImage;
const alt = `'Theresa Mine ${layer}ground'`;

// Absent below 768px per the hero's two-layer mobile spec (mid and type
// only); mid has no such class and stays visible at every breakpoint.
const mobileVisibility = layer === 'back' || layer === 'front' ? 'hidden md:block' : undefined
---

<div
  data-hero-layer={layer}
  aria-hidden="true"
  role="presentation"
  class:list={['absolute', 'inset-y-[-20%]', mobileVisibility, className]}
>
  <Image src={src} alt={alt} />
</div>