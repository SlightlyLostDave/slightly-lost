STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=
# STRAPI_TOKEN needs permission to read drafts (status=draft) when
# STRAPI_PREVIEW=true, not just published entries.
STRAPI_PREVIEW=false
STRAPI_FORCE_FULL_SYNC=false
# Folder holding the atlas basemap (overview.pmtiles, detail.pmtiles, and
# fonts/). Defaults to /basemap, served from public/basemap. Can point at any
# host that answers HTTP range requests and allows CORS from the site origin.
# See docs/basemap.md.
PUBLIC_BASEMAP_URL=/basemap
